# Copier ce fichier en ".env" puis adapter si besoin.
# docker compose charge automatiquement .env à la racine.

# --- Ports exposés ---
EVENTS_PORT=3001
PARTICIPANTS_PORT=3002
REGISTRATIONS_PORT=3003
FRONTEND_PORT=80
DB_EVENTS_PORT=5432
DB_PARTICIPANTS_PORT=5433
DB_REGISTRATIONS_PORT=5434

# --- PostgreSQL Events ---
EVENTS_DB_USER=event_user
EVENTS_DB_PASSWORD=event_password
EVENTS_DB_NAME=events_db

# --- PostgreSQL Participants ---
PARTICIPANTS_DB_USER=participant_user
PARTICIPANTS_DB_PASSWORD=participant_password
PARTICIPANTS_DB_NAME=participants_db

# --- PostgreSQL Registrations ---
REGISTRATIONS_DB_USER=registration_user
REGISTRATIONS_DB_PASSWORD=registration_password
REGISTRATIONS_DB_NAME=registrations_db

# --- Runtime ---
NODE_ENV=production

# --- Production (docker-compose.prod.yml / deploy) ---
GHCR_OWNER=jomusenga
IMAGE_TAG=latest

# --- URLs frontend (navigateur → APIs hôte) ---
# En local : localhost. En prod : IP ou domaine du serveur (ex. http://51.38.x.x:3001)
VITE_EVENTS_API_URL=http://localhost:3001
VITE_PARTICIPANTS_API_URL=http://localhost:3002
VITE_REGISTRATIONS_API_URL=http://localhost:3003
